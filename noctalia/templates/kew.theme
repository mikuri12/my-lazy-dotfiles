
[theme]
name=noctalia

accent={{colors.primary.default.hex}}
text={{colors.on_surface.default.hex}}
textDim={{colors.on_surface_variant.default.hex}}
textMuted={{colors.outline.default.hex}}

logo={{colors.primary.default.hex}}
header={{colors.primary.default.hex}}
footer={{colors.outline.default.hex}}
help={{colors.secondary.default.hex}}
link={{colors.tertiary.default.hex}}
nowplaying={{colors.primary.default.hex}}
playbackstatus={{colors.secondary.default.hex}}

playlist.rownum={{colors.outline.default.hex}}
playlist.title={{colors.on_surface.default.hex}}
playlist.playing={{colors.primary.default.hex}}

trackview.title={{colors.primary.default.hex}}
trackview.artist={{colors.secondary.default.hex}}
trackview.album={{colors.tertiary.default.hex}}
trackview.year={{colors.on_surface_variant.default.hex}}
trackview.time={{colors.on_surface_variant.default.hex}}
trackview.visualizer={{colors.primary.default.hex}}
trackview.lyrics={{colors.on_surface.default.hex}}

library.artist={{colors.primary.default.hex}}
library.album={{colors.secondary.default.hex}}
library.track={{colors.on_surface.default.hex}}
library.enqueued={{colors.tertiary.default.hex}}
library.playing={{colors.primary.default.hex}}

search.label={{colors.secondary.default.hex}}
search.query={{colors.on_surface.default.hex}}
search.result={{colors.on_surface_variant.default.hex}}
search.enqueued={{colors.tertiary.default.hex}}
search.playing={{colors.primary.default.hex}}

progress.filled={{colors.primary.default.hex}}
progress.empty={{colors.surface_variant.default.hex}}
progress.elapsed={{colors.secondary.default.hex}}

status.info=-1
status.warning={{colors.tertiary.default.hex}}
status.error={{colors.error.default.hex}}
status.success={{colors.secondary.default.hex}}
