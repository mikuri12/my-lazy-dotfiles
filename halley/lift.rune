@description "Halley Lift configuration"

gather "colors.rune"

lift:
  placeholder "Search apps, nodes, clusters, actions..."

  width 760
  
  max-results 12 
  visible-results 8

  fuzzy true
  show-section-labels true
  
  icons true
  icon-size 28
  icon-theme "auto"
  icon-search-depth 5
  
  terminal "x-terminal-emulator -e"
  
  close-on-focus-loss false
  
  alt-number-jump true

  position:
    anchor "center"
    offset-x 0
    offset-y 0
  end

  rounding:
    panel 18
    dropdown 14
    search 12
    row 12
    badge 10
    draft 10
  end

  border:
    enabled true
    width 1
    style "outline"
  end

  search-icon:
    enabled true
    side "left"
    size 22
  end

  cursor:
    enabled true
    width 2
    blink-ms 500
    stop-blink-after-ms 5000
  end

  ui:
    top-margin 96
    padding 20
    dropdown-gap 0
    dropdown-padding 10
    search-height 60
    draft-height 36
    row-height 64
    row-gap 6
    section-height 22
    footer-height 0
    font "BigBlueTermPlus Nerd Font"
    search-font-size 22
    badge-font-size 15
    title-font-size 17
    subtitle-font-size 13
    hint-font-size 12
  end

  modes:
    apps true
    clusters true
    nodes true
    actions true
    config true
  end

  providers [
    "apps"
    "clusters"
    "nodes"
    "actions"
  ]
end
