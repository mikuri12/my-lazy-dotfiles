@author "mikuri"

gather "colors.rune"

env:
  QT_QPA_PLATFORM "wayland"
  QT_QPA_PLATFORMTHEME "gtk3"
  GDK_BACKEND "wayland"
  MOZ_ENABLE_WAYLAND "1"
  ELECTRON_OZONE_PLATFORM_HINT "auto"
  NIXOS_OZONE_WL "1"
  LIBVA_DRIVER_NAME "iHD"
  HALLEY_IPC_SOCKET "/run/user/1000/halley/halley.sock"
end

autostart:
  once "sh ~/.config/halley/session-services.sh"
  once "noctalia"
end

cursor:
  theme "MikuCat"
  size 22
  hide-when-typing true
  hide-after-ms 2000
end

input:
  repeat-rate 30
  repeat-delay 500
  focus-mode "click"
  raise-on-click true

  mouse:
    accel-speed "-0.5"
    accel-profile "flat"
    natural-scroll false
  end

  keyboard:
    layout "us"
    variant ""
    options ""
    model ""
  end

  gestures:
    enabled true
    client-passthrough true
    touch-passthrough true
    pinch-to-zoom true
    pinch-scope "global"
    compositor-scope "global"
    modifier "super"
    scroll-pan "empty-field"
    swipe-threshold-px 120
    pan-fingers 3
    pan-momentum true
    pan-decay-rate 6
    flick-min-px-per-s 200
    swipe-up-4 "apogee-open"
    apogee-swipe-down-4 "apogee-close"
  end

  touchpad:
    tap true
    natural-scroll true
    dwt true
    accel-profile "adaptive"
    scroll-method "two-finger"
    click-method "clickfinger"
  end
end

font:
  family "BigBlueTermPlus Nerd Font"
  size 11
end

screenshot:
  directory "$env.HOME/Pictures/Screenshots/"
end

debug:
  overlay-fps false
  show-ring-when-resizing true
end

apogee:
  enabled true
  live-previews false
  transition-ms 320
  gap 24
  max-rows 3
  background-dim 0.85
end

view:
  output:
    name "HDMI-A-1"
    width 1366
    height 768
    rate 59.790
    transform 0
    vrr "off"
    focus-ring:
      radius-x 820.0
      radius-y 420.0
      offset-x 0.0
      offset-y 0.0
    end
  end
end

wallpaper:
  mode "none"
  animated false
end

field:
  gap 20.0

  pins:
    corner "top-right"
    size 1.0
  end

  close-restore-focus true
  close-restore-pan "if-offscreen"

  zoom:
    enabled true
    step 1.20
    min 0.35
    smooth-rate 12.5
  end
end

node:
  show-labels "hover"
  show-app-icons "always"

  shape "square"
  label-shape "square"

  icon-size 0.72
  opacity 1.0

  click-collapsed-pan "if-offscreen"
end

decay:
  enabled true
  outside-delay-seconds 240
  inside-delay-seconds 120
end

trail:
  history-length 25
  wrap true
end

bearings:
  show-distance true
  show-icons true
  show-pinned true
  fade-distance 1200
end

clusters:
  cluster-dwell-ms 2000
  distance-px 280.0
  bloom-direction "clockwise"
  show-icons true
  default-layout "stacking"
  core-shape "square"
end

tile:
  new-on-top false
  gaps-inner 20
  gaps-outer 20
  max-stack 4
  queue-show-icons true
end

stacking:
  max-visible 5
end

physics:
  enabled false
  damping 0.45
end

fullscreen:
  preserve-top-panels true
end

animations:
  enabled true

  smooth-resize:
    enabled true
    duration-ms 90
  end

  maximize:
    enabled true
    duration-ms 240
  end

  fullscreen:
    enabled true
    duration-ms 240
  end

  window-open:
    enabled true
    duration-ms 300
  end

  window-close:
    enabled true
    duration-ms 270
    type "retract"
  end

  tile:
    enabled true
    duration-ms 240
  end

  stack:
    enabled true
    duration-ms 220
  end

  cluster:
    enabled true
    tiling:
      open-duration-ms 300
      stagger-ms 55
      close-duration-ms 420
      reflow-duration-ms 400
    end
    stacking:
      open-duration-ms 240
      close-duration-ms 360
    end
  end
end

effects:
  blur:
    overlays false
    radius 24
    passes 0
    saturation 1.10
    noise 0.012
  end

  shadows:
    window:
      enabled false
      blur-radius 1
      spread 6
      offset-x 0
      offset-y 0
    end

    node:
      enabled true
      blur-radius 12
      spread 3
      offset-x 0
      offset-y 8
    end

    overlay:
      enabled true
      blur-radius 18
      spread 4
      offset-x 0
      offset-y 10
    end
  end
end

decorations:
  border:
    size 2
    radius 0
  end

  secondary-border:
    enabled true
    size 6
    gap 0
  end

  titlebars:
    enabled true
    follow-border false
    button-position "right"
   title-position "center"
    show-buttons true
    show-icons false
    show-title false
    radius 0 
     
    height 28
    text-size 10
    icon-close "icons/close.svg"
    icon-minimize "icons/minimize.svg"
    icon-maximize "icons/maximize.svg"
    icon-unmaximize "icons/unmaximize.svg"
  end

  resize-using-border true
end

overlays:
  radius 0
  borders true
  shape "square"
end

keybinds:
  mod "super"

  "$var.mod+ctrl+r" "reload"
  "$var.mod+n" "toggle-state"
  "$var.mod+m" "maximize-focused"
  "$var.mod+f" "toggle-fullscreen"
  "$var.mod+p" "noctalia msg screenshot-fullscreen || halleyctl capture screen"
  "$var.mod+q" "cluster-layout cycle"

  "$var.mod+scroll-up" "zoom-in"
  "$var.mod+scroll-down" "zoom-out"
  "$var.mod+click-middle" "zoom-reset"
  "$var.mod+equal" "zoom-in"
  "$var.mod+plus" "zoom-in"
  "$var.mod+minus" "zoom-out"

  "$var.mod+shift+e" "quit"
  "$var.mod+shift+q" "toggle-widget-floating"

  "$var.mod+left" "node-move left"
  "$var.mod+right" "node-move right"
  "$var.mod+up" "node-move up"
  "$var.mod+down" "node-move down"

  "$var.mod+h" "maximize-focused"
  "$var.mod+g" "apogee"

  "$var.mod+shift+left" "monitor-focus left"
  "$var.mod+shift+right" "monitor-focus right"
  "$var.mod+shift+up" "monitor-focus up"
  "$var.mod+shift+down" "monitor-focus down"

  "$var.mod+left" "tile-focus left"
  "$var.mod+right" "tile-focus right"
  "$var.mod+up" "tile-focus up"
  "$var.mod+down" "tile-focus down"

  "$var.mod+left" "stack-cycle forward"
  "$var.mod+right" "stack-cycle backward"

  "$var.mod+shift+c" "cluster-mode"
  "$var.mod+shift+l" "cluster-layout cycle"
  "$var.mod+1" "cluster slot 1"
  "$var.mod+2" "cluster slot 2"
  "$var.mod+3" "cluster slot 3"
  "$var.mod+4" "cluster slot 4"
  "$var.mod+5" "cluster slot 5"
  "$var.mod+6" "cluster slot 6"
  "$var.mod+7" "cluster slot 7"
  "$var.mod+8" "cluster slot 8"
  "$var.mod+9" "cluster slot 9"
  "$var.mod+0" "cluster slot 10"

  "$var.mod+z" "bearings-show"
  "$var.mod+shift+z" "bearings-toggle"

  "$var.mod+period" "trail-next"
  "$var.mod+shift+comma" "trail-prev"

  "alt+tab" "cycle-focus"
  "alt+shift+tab" "cycle-focus-backward"

  "$var.mod+return" "foot"
  "$var.mod+t" "foot"
  "$var.mod+d" "fuzzel"

  "$var.mod+click-left" "pan-field"
  "$var.mod+shift+click-left" "move-window"
  "$var.mod+click-right" "resize-window"

  "$var.mod+ctrl+left" "tile-swap left"
  "$var.mod+ctrl+right" "tile-swap right"
  "$var.mod+ctrl+up" "tile-swap up"
  "$var.mod+ctrl+down" "tile-swap down"

  "$var.mod+shift+s" "halleyctl capture menu"

  "$var.mod+e" "foot -e yazi"
  "$var.mod+shift+w" "brave"
  "$var.mod+c" "close-focused"

  "$var.mod+a" "noctalia msg panel-toggle launcher"
  "$var.mod+s" "noctalia msg panel-toggle control-center"
  "$var.mod+comma" "noctalia msg settings-toggle"
  "$var.mod+v" "noctalia msg panel-toggle clipboard"
  "$var.mod+l" "noctalia msg screen-lock"
  "$var.mod+j" "noctalia msg bar-toggle"
  "$var.mod+ctrl+t" "noctalia msg panel-toggle wallpaper"

  "$var.mod+shift+p" "noctalia msg screenshot-region || halleyctl capture region"

  "XF86AudioRaiseVolume" "wpctl set-volume -l 1 @default_audio_sink@ 5%+"
  "XF86AudioLowerVolume" "wpctl set-volume @default_audio_sink@ 5%-"
  "XF86AudioMute" "wpctl set-mute @default_audio_sink@ toggle"
end
